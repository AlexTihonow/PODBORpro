# Пример настроек. Скопируйте в .env (он в .gitignore) и впишите значения:
#   cp .env.example .env
# Сюда — только пустые значения и значения по умолчанию, без секретов.

# Ключ Z.AI для составления сопроводительных писем. Пусто — функция выключена (503).
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.7-flash
ZAI_TIMEOUT_SECONDS=60
# Сколько писем в час может составить один пользователь.
COVER_LETTER_LIMIT_PER_HOUR=10

# Секрет подписи токенов входа; на общем сервере обязательно свой (32+ символа).
JWT_SECRET=
