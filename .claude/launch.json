{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "web/dev-server.mjs"
      ],
      "port": 5173
    },
    {
      "name": "web-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "web/dev-server.mjs"
      ],
      "port": 5175,
      "env": {
        "PORT": "5175",
        "API_URL": "http://localhost:8080"
      },
      "autoPort": false
    },
    {
      "name": "server",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "-C",
        "server",
        "run",
        "./cmd/server"
      ],
      "port": 8080,
      "env": {
        "DATABASE_URL": "postgres://podbor:podbor@localhost:5433/podbor?sslmode=disable",
        "JWT_SECRET": "dev-secret-dev-secret-dev-secret-dev",
        "WEB_DIR": "../web",
        "HTTP_ADDR": ":8080"
      },
      "autoPort": false
    }
  ]
}
