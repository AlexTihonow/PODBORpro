{
  "name": "podborpro-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "generate:types": "openapi-typescript ../server/api/openapi.yaml -o src/api/schema.d.ts",
    "generate:stubs": "node scripts/extract-stubs.mjs",
    "generate": "openapi-typescript ../server/api/openapi.yaml -o src/api/schema.d.ts && node scripts/extract-stubs.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "yaml": "^2.6.1"
  }
}
